# Copy to .env (never commit .env) and replace every placeholder.
# Generate values e.g. with: openssl rand -base64 32
SPRING_PROFILES_ACTIVE=prod
MYSQL_DATABASE=pricedb
MYSQL_ROOT_PASSWORD=change-me
DB_URL=jdbc:mysql://price-db:3306/pricedb?allowPublicKeyRetrieval=true&useSSL=false
DB_USERNAME=priceuser
DB_PASSWORD=change-me
# Shared secret; test-purchase-application must send it as X-API-Key
PRICING_API_KEY=change-me
# Optional overrides of the country base rates (EUR)
# PRICING_DEFAULT_BASE_RATE=150.00
# PRICING_COUNTRY_BASE_RATES_GERMANY=150.00
# PRICING_COUNTRY_BASE_RATES_AUSTRIA=160.00
